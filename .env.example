# ==============================================================
# ComplianceFlow AI — Platform Environment Variables
# ==============================================================
# Copy this file to .env and fill in your values.
# These are PLATFORM-LEVEL secrets only.
# Client credentials are NEVER stored here — they use STS AssumeRole.
# ==============================================================

# --- Runtime ---
NODE_ENV=development
PORT=3000

# --- Application URLs ---
APP_URL=https://www.compflow.icu
API_URL=https://api.compflow.icu

# --- Session & Token Signing ---
# REQUIRED in production. Generate with: node -e "console.log(require('crypto').randomBytes(64).toString('hex'))"
AUTH_SECRET=
# Alias accepted (legacy):
# JWT_SECRET=

# --- Google OAuth 2.0 ---
# Create at: https://console.cloud.google.com/apis/credentials
# Application type: Web application
# Authorized JS origins: https://www.compflow.icu, https://compflow.icu, http://localhost:3000
# Authorized redirect URIs: https://api.compflow.icu/api/auth/google/callback, http://localhost:3000/api/auth/google/callback
# Scopes: openid, email, profile
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# --- GitHub OAuth App ---
# Create at: https://github.com/settings/applications/new
# Homepage URL: https://www.compflow.icu
# Authorization callback URL: https://api.compflow.icu/api/auth/github/callback
# Scopes requested in code: read:user, user:email, read:org
GITHUB_CLIENT_ID=
GITHUB_CLIENT_SECRET=

# --- Pilot Access Code (pre-SSO fallback) ---
# Set a code to allow pilot users to sign in without OAuth.
# Leave empty to disable pilot access.
PILOT_ACCESS_CODE=

# --- Domain & Organization Restrictions (optional) ---
# Comma-separated list of allowed email domains. Empty = allow all.
# Example: ALLOWED_DOMAINS=acme.com,contoso.org,compflow.icu
ALLOWED_DOMAINS=

# Comma-separated list of allowed GitHub org logins. Empty = allow all.
# Example: ALLOWED_GITHUB_ORGS=acme-corp,contoso-security
ALLOWED_GITHUB_ORGS=

# Reject personal email providers (gmail.com, yahoo.com, etc.)
# Set to "true" to block consumer emails.
REJECT_PERSONAL_EMAILS=false

# --- Google Gemini (LLM Reasoning Engine) ---
GEMINI_API_KEY=your-gemini-api-key-here

# --- Platform AWS Identity ---
# This is YOUR platform's AWS IAM user, used for:
#   1. STS AssumeRole (to access client accounts)
#   2. SES (to send compliance reports)
# Permissions needed: sts:AssumeRole, ses:SendEmail, ses:SendRawEmail
PLATFORM_AWS_ACCESS_KEY_ID=
PLATFORM_AWS_SECRET_ACCESS_KEY=
AWS_REGION=us-east-1

# --- Email Reporting (AWS SES) ---
# Must be a verified SES identity (domain or email address)
AWS_SES_FROM_EMAIL=reports@complianceflow.ai

# --- PostgreSQL (optional — falls back to in-memory store) ---
POSTGRES_HOST=localhost
POSTGRES_PORT=5432
POSTGRES_DB=compflow
POSTGRES_USER=compflow_user
POSTGRES_PASSWORD=compflow_pass
