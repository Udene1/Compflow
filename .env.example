# ==============================================================
# Compflow — Pilot Environment Variables
# ==============================================================
# Copy this file to .env and fill in the values required by your deployment.
# PostgreSQL is the authoritative durable store. Redis is the dispatch/queue layer.
# Cloud credentials belong in Compflow's encrypted SecretStore/onboarding flow;
# never commit provider credentials to this file.
# ==============================================================

# --- Runtime ---
NODE_ENV=production
PORT=3000

# --- Application URLs ---
APP_URL=https://www.compflow.icu
API_URL=https://api.compflow.icu

# --- Session & Token Signing ---
# REQUIRED in production. Generate with: node -e "console.log(require('crypto').randomBytes(64).toString('hex'))"
AUTH_SECRET=

# --- Google OAuth 2.0 ---
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# --- GitHub OAuth App ---
GITHUB_CLIENT_ID=
GITHUB_CLIENT_SECRET=

# --- Pilot Access Code (explicit pilot entitlement) ---
# Leave empty to disable pilot-code login. A successful pilot login grants
# a time-bounded PILOT entitlement; authenticated users without an entitlement
# cannot scan, inspect cloud data, remediate, or run compliance executions.
PILOT_ACCESS_CODE=
PILOT_ACCESS_DAYS=30

# --- Domain & Organization Restrictions (optional) ---
ALLOWED_DOMAINS=
ALLOWED_GITHUB_ORGS=
REJECT_PERSONAL_EMAILS=true

# --- Google Gemini (optional analyst layer) ---
# Deterministic scanning, risk and remediation do not depend on the LLM.
GEMINI_API_KEY=
GEMINI_ANALYST_MODEL=gemini-1.5-flash

# --- Platform AWS Identity ---
# Used only for platform-owned AWS operations such as STS/SES.
# Customer cloud credentials are not configured here.
PLATFORM_AWS_ACCESS_KEY_ID=
PLATFORM_AWS_SECRET_ACCESS_KEY=
AWS_REGION=us-east-1

# --- Email Reporting (AWS SES, optional) ---
AWS_SES_FROM_EMAIL=

# --- PostgreSQL (REQUIRED) ---
POSTGRES_HOST=localhost
POSTGRES_PORT=5432
POSTGRES_DB=compflow
POSTGRES_USER=compflow_user
POSTGRES_PASSWORD=

# --- Redis / BullMQ (REQUIRED) ---
REDIS_URL=redis://localhost:6379
REDIS_HOST=localhost
REDIS_PORT=6379
