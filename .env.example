# ==============================================================
# ComplianceFlow — Pilot Environment Variables
# ==============================================================
# Copy this file to .env and fill in the values required by your deployment.
# NEVER commit the real .env file or provider credentials.
# Customer cloud credentials are entered through the encrypted onboarding/
# SecretStore flow; they do not belong in this file.
# ==============================================================

# --- Runtime ---
NODE_ENV=production
PORT=3000

# --- Application URLs ---
APP_URL=https://www.compflow.icu
API_URL=https://api.compflow.icu

# --- Session & Token Signing ---
# REQUIRED in production. Generate with:
# node -e "console.log(require('crypto').randomBytes(64).toString('hex'))"
AUTH_SECRET=

# --- Native Owner Authentication ---
# Exact first-owner email. Do not broaden this to an entire domain.
OWNER_EMAIL=kenneth@compflow.icu
# One-time secret required to claim the initial OWNER account.
# Generate a strong random value and remove/rotate it after bootstrap.
OWNER_BOOTSTRAP_CODE=

# --- Pilot Access ---
# Access code used by invited pilot users when pilot-code login is enabled.
PILOT_ACCESS_CODE=

# --- Google OAuth 2.0 (optional) ---
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# --- GitHub OAuth App (optional) ---
GITHUB_CLIENT_ID=
GITHUB_CLIENT_SECRET=

# --- Private Pilot Operations ---
# Comma-separated platform-admin email addresses allowed to create/revoke pilot invitations.
# This is NOT a customer entitlement and is separate from organization roles.
COMPFLOW_PLATFORM_ADMINS=
# Default invitation duration is 30 days; the private console permits 1–90 days.

# --- Domain & Organization Restrictions (optional) ---
# Comma-separated allowed email domains. Leave empty to allow all non-personal domains.
ALLOWED_DOMAINS=
# Comma-separated GitHub organizations allowed for GitHub SSO.
ALLOWED_GITHUB_ORGS=
REJECT_PERSONAL_EMAILS=true

# --- Google Gemini analyst layer (optional) ---
# Deterministic scanning, risk analysis and remediation do not depend on the LLM.
GEMINI_API_KEY=
GEMINI_ANALYST_MODEL=gemini-1.5-flash

# --- Platform AWS Identity (optional, platform operations only) ---
# Used only for platform-owned AWS operations such as STS/SES.
# Customer AWS credentials MUST NOT be placed here.
PLATFORM_AWS_ACCESS_KEY_ID=
PLATFORM_AWS_SECRET_ACCESS_KEY=
AWS_REGION=us-east-1

# --- Email Reporting / AWS SES (optional) ---
AWS_SES_FROM_EMAIL=

# --- PostgreSQL (REQUIRED) ---
# For docker-compose, POSTGRES_HOST/PORT are overridden to the postgres service.
POSTGRES_HOST=localhost
POSTGRES_PORT=5432
POSTGRES_DB=compflow
POSTGRES_USER=compflow_user
POSTGRES_PASSWORD=

# --- Redis / BullMQ (REQUIRED) ---
# REDIS_URL may be used by queue clients that accept a full connection URL.
REDIS_URL=redis://localhost:6379
REDIS_HOST=localhost
REDIS_PORT=6379

# ==============================================================
# Production checklist
# ==============================================================
# Required for the production pilot:
#   AUTH_SECRET
#   POSTGRES_* connection values
#   REDIS_* / REDIS_URL
#   OWNER_EMAIL
#   OWNER_BOOTSTRAP_CODE (only until the initial owner is claimed)
#
# Enable only what you actually use:
#   PILOT_ACCESS_CODE
#   GOOGLE_CLIENT_ID / GOOGLE_CLIENT_SECRET
#   GITHUB_CLIENT_ID / GITHUB_CLIENT_SECRET
#   GEMINI_API_KEY
#   PLATFORM_AWS_ACCESS_KEY_ID / PLATFORM_AWS_SECRET_ACCESS_KEY
#   AWS_SES_FROM_EMAIL
#   ALLOWED_DOMAINS / ALLOWED_GITHUB_ORGS
#
# Never place customer AWS/Azure/GCP/DigitalOcean/Hetzner credentials here.
